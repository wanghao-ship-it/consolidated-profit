# PostgreSQL business database and separate LangGraph checkpoint database.
POSTGRES_USER=profit_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=profit_business
DATABASE_URL=postgresql+psycopg://profit_app:replace-with-a-long-random-password@127.0.0.1:5432/profit_business
CHECKPOINT_DATABASE_URL=postgresql://profit_app:replace-with-a-long-random-password@127.0.0.1:5432/profit_checkpoint

# MinIO. The example uses the local MinIO root account; create a restricted app
# user for a shared or production deployment.
MINIO_ROOT_USER=profit_minio
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=profit_minio
MINIO_SECRET_KEY=replace-with-another-long-random-password
MINIO_BUCKET=renheng-profit
MINIO_SECURE=false

# Generate a separate value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_SECONDS=28800
LANGGRAPH_STRICT_MSGPACK=true
